# Identity — Clerk (optional; app runs in demo identity mode without these)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Persistent CPL Core — any PostgreSQL-compatible database
DATABASE_URL=
DATABASE_SSL=true

# Commerce — Medusa v2
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
MEDUSA_WEBHOOK_SECRET=

# AI — Vercel AI Gateway. Default is a low-cost tool-capable model.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-luna

# Real lab execution — Vercel Sandbox. OIDC is automatic on Vercel.
VERCEL_OIDC_TOKEN=
CPL_SANDBOX_MODE=simulated
